{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bytwina Browser",
  "version": "0.0.5",
  "identifier": "dev.bytwina.browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: asset:; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost blob:; object-src 'none'; frame-src 'self' blob:; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ninokiru/Bytwina-Browser/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
