{
  "name": "bytwina-browser-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "build:patch": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));const now=new Date();const d=now.getFullYear().toString().slice(2)+String(now.getMonth()+1).padStart(2,'0')+String(now.getDate()).padStart(2,'0');const n=String(process.env.BUILD_NUM??1).padStart(2,'0');p.version='0.0.1-bytw '+d+'.'+n;fs.writeFileSync('package.json',JSON.stringify(p,null,2));console.log('version -> '+p.version)\" && vite build"
  },
  "dependencies": {
    "@codemirror/view": "^6.43.14",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.108.0",
    "@tauri-apps/api": "^2",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.73.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.3",
    "react-virtuoso": "^4.18.13",
    "rehype-sanitize": "^6.0.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.6"
  }
}